<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShoppingList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#006C4C</item>
        <item name="android:windowBackground">@drawable/liquid_bg</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="colorPrimaryContainer">#4DFFFFFF</item>
        <item name="colorOnPrimaryContainer">#191C1A</item>
        <item name="colorSurface">#33FFFFFF</item>
        <item name="colorOnSurface">#191C1A</item>
        <item name="cardViewStyle">@style/GlassCard</item>
    </style>

    <style name="GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#80FFFFFF</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#4DFFFFFF</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
</resources>
